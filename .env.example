# ══════════════════════════════════════════════════════════════
# Dr. MRS Bhalla DAV School — Environment Variables Template
# DO NOT PUT REAL SECRETS IN THIS FILE.
# This file is tracked in Git. Copy to .env.local for development.
# ══════════════════════════════════════════════════════════════

# ── Site Configuration ────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.drmrsbhalladavschool.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_code_here

# ── Sanity CMS ────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-08-31

# ── Supabase (Public / Client) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# ── Supabase (Server-side Secret - NEVER EXPOSE) ──────────────
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Admin Security ────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com

# ── Firebase Analytics (GA4) ──────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ── Optional Services ─────────────────────────────────────────
RESEND_API_KEY=
